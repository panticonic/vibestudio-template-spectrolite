{
  "name": "@workspace/testkit",
  "version": "0.1.0",
  "description": "In-system E2E testing, orchestration, supervision and profiling SDK for userland code",
  "type": "module",
  "vibestudio": {
    "authority": {
      "requests": [],
      "serviceRequests": [
        {
          "protocol": "vibestudio.testkit-driver.v1",
          "availability": "required"
        }
      ],
      "provides": []
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./suites": "./src/suites/index.ts",
    "./profiling": "./src/profile-core.ts"
  },
  "dependencies": {
    "@vibestudio/service-schemas": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "@workspace/cdp-client": "workspace:*"
  }
}
