{
  "name": "@workspace-extensions/file-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "displayName": "File Tools",
    "icon": "./assets/icon.svg",
    "entry": "index.ts",
    "sourcemap": true,
    "extension": {
      "activationEvents": [
        "onInvoke"
      ],
      "dependencyMode": "external",
      "methodAuthority": {
        "grep": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Reads workspace files and search results without a website disclosure contract."
          }
        },
        "find": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Reads workspace files and search results without a website disclosure contract."
          }
        },
        "read": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Reads workspace files and search results without a website disclosure contract."
          }
        }
      }
    },
    "authority": {
      "provides": [],
      "requests": [
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "critical",
          "evidence": "intentional-broad"
        }
      ]
    }
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0"
  }
}
